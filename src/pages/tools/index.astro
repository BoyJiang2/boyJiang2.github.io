---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryRow from '../../components/EntryRow.astro';
import { tools } from '../../config/tools';
---

<BaseLayout title="工具 — Boy Jiang" description="用于学习与研究的交互工具。">
  <header class="page-head shell">
    <p class="page-kicker">Tools</p>
    <h1><span class="page-title-icon" aria-hidden="true">⌘</span>工具</h1>
  </header>
  <section class="content-shell shell">
    <div class="entry-list">
      {tools.map((tool) => <EntryRow {...tool} />)}
    </div>
  </section>
</BaseLayout>
