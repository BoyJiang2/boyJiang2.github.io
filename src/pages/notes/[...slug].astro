---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedNotes } from '../../utils/content';
import { buildNoteTree, getNoteLocation } from '../../utils/notes';
import { getArticleWordCount } from '../../utils/article-meta';
export async function getStaticPaths() {
  const entries = await getPublishedNotes();
  return entries.map((entry) => ({ params: { slug: getNoteLocation(entry).slug }, props: { entry, entries } }));
}
const { entry, entries } = Astro.props;
const { Content, headings } = await render(entry);
const wordCount = getArticleWordCount(entry.body);
const tree = buildNoteTree(entries, entry.id);
---

<ArticleLayout documentTitle={`${entry.data.title} — 笔记`} description={entry.data.summary} title={entry.data.title} summary={entry.data.summary} backHref="/notes/" backLabel="← 返回笔记" tags={entry.data.tags} wordCount={wordCount} variant="reading" collectionLabel="浏览全部笔记" tree={tree} headings={headings}>
  <Content />
</ArticleLayout>
