---
import { getPublishedNotes, noteHref } from '../../utils/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryRow from '../../components/EntryRow.astro';
import { getNoteLocation } from '../../utils/notes';
const entries = await getPublishedNotes();
const categories = ['全部', ...new Set(entries.map((entry) => getNoteLocation(entry).category))];
---

<BaseLayout title="笔记 — Boy Jiang" description="论文阅读笔记。">
  <header class="page-head shell">
    <p class="page-kicker">Notes</p>
    <h1><span class="page-title-icon" aria-hidden="true">☘</span>笔记</h1>
  </header>
  <section class="content-shell shell">
    {entries.length > 0 && <div class="filter-bar">
      {categories.map((category, index) => <button class:list={['filter-button', index === 0 && 'active']} data-filter={category}>{category}</button>)}
    </div>}
    {entries.length > 0 ? <div class="entry-list" id="notes-list">
      {entries.map((entry) => {
        const location = getNoteLocation(entry);
        return (
          <EntryRow class="note-filter-item" data-category={location.category} href={noteHref(entry)} eyebrow={location.category} meta={location.series} title={entry.data.title} summary={entry.data.summary} tags={entry.data.tags} />
        );
      })}
    </div> : <div class="empty-state">笔记正在整理，暂不公开。</div>}
  </section>
  <script is:inline>
    const buttons = [...document.querySelectorAll('[data-filter]')];
    const items = [...document.querySelectorAll('.note-filter-item')];
    let activeType = '全部';
    const update = () => {
      items.forEach((item) => {
        const matchesType = activeType === '全部' || item.dataset.category === activeType;
        item.hidden = !matchesType;
      });
    };
    buttons.forEach((button) => button.addEventListener('click', () => {
      activeType = button.dataset.filter;
      buttons.forEach((candidate) => candidate.classList.toggle('active', candidate === button));
      update();
    }));
  </script>
</BaseLayout>
