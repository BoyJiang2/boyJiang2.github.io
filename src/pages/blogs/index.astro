---
import { blogHref, getPublishedBlogs } from '../../utils/content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import EntryRow from '../../components/EntryRow.astro';
const entries = await getPublishedBlogs();
---

<BaseLayout title="博客 — Boy Jiang" description="关于学习、技术与生活的个人思考。">
  <header class="page-head shell">
    <p class="page-kicker">Blog</p>
    <h1><span class="page-title-icon" aria-hidden="true">✦</span>博客</h1>
  </header>
  <section class="content-shell shell">
    {entries.length > 0 ? <div class="entry-list">
      {entries.map((entry) => <EntryRow href={blogHref(entry)} title={entry.data.title} summary={entry.data.summary} tags={entry.data.tags} />)}
    </div> : <div class="empty-state">文章正在整理，稍后发布。</div>}
  </section>
</BaseLayout>
