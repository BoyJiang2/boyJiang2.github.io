---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { blogHref, getPublishedBlogs } from '../../utils/content';
import { getArticleWordCount } from '../../utils/article-meta';
export async function getStaticPaths() {
  const entries = await getPublishedBlogs();
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry, entries } }));
}
const { entry, entries } = Astro.props;
const { Content, headings } = await render(entry);
const wordCount = getArticleWordCount(entry.body);
const tree = [{
  label: '全部文章',
  icon: '✦',
  children: entries.map((item) => ({
    label: item.data.title,
    href: blogHref(item),
    current: item.id === entry.id,
  })),
  open: true,
}];
---

<ArticleLayout documentTitle={`${entry.data.title} — Boy Jiang`} description={entry.data.summary} title={entry.data.title} summary={entry.data.summary} backHref="/blogs/" backLabel="← 返回博客" tags={entry.data.tags} wordCount={entry.data.wide ? undefined : wordCount} variant={entry.data.wide ? 'wide' : 'reading'} collectionLabel="浏览全部博客" tree={tree} headings={headings}>
  <Content />
</ArticleLayout>
