---
import RedirectLayout from '../../layouts/RedirectLayout.astro';
import { blogHref, getPublishedBlogs } from '../../utils/content';
export const prerender = true;
export async function getStaticPaths() {
  return (await getPublishedBlogs()).map((entry) => ({
    params: { slug: entry.id },
    props: { destination: blogHref(entry) },
  }));
}
const { destination } = Astro.props;
---

<RedirectLayout destination={destination} linkLabel="前往文章" />
