---
import { render } from 'astro:content';
import ArticleLayout from '../../layouts/ArticleLayout.astro';
import { getPublishedProjects } from '../../utils/content';
export async function getStaticPaths() {
  return (await getPublishedProjects()).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const { Content } = await render(entry);
---

<ArticleLayout documentTitle={`${entry.data.title} — 项目`} description={entry.data.summary} title={entry.data.title} summary={entry.data.summary} backHref="/projects/" backLabel="← 返回项目" kicker="Project" tags={entry.data.tags} variant="plain">
  <div slot="header-actions" class="project-detail-links">
    <a class="project-action project-action-primary" href={entry.data.github} target="_blank" rel="noreferrer">GitHub ↗</a>
  </div>
  <Content />
</ArticleLayout>
