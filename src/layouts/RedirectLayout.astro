---
interface Props {
  destination: string;
  linkLabel: string;
}

const { destination, linkLabel } = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>Boy Jiang</title>
    <meta http-equiv="refresh" content={`0;url=${destination}`} />
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(destination, Astro.site ?? Astro.url)} />
  </head>
  <body><a href={destination}>{linkLabel}</a></body>
</html>
