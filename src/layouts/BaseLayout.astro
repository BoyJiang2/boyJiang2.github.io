---
import { Image, getImage } from 'astro:assets';
import logoLight from '../../public/brand/logo-navy-gold.png';
import logoDark from '../../public/brand/logo-ivory-gold.png';
import iconSource from '../../public/brand/site-icon-white.png';
import { DEFAULT_THEME_ID, THEME_STORAGE_KEY, themes } from '../config/themes';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Boy Jiang',
  description = '蒋博睿的个人介绍与科研成果。',
} = Astro.props;
const favicon = await getImage({ src: iconSource, width: 48, height: 48, format: 'png' });
const touchIcon = await getImage({ src: iconSource, width: 180, height: 180, format: 'png' });
const pathname = Astro.url.pathname;
const primaryNav = [
  { href: '/notes/', label: '笔记' },
  { href: '/blogs/', label: '博客' },
];
const defaultTheme = themes.find((theme) => theme.value === DEFAULT_THEME_ID)!;
---

<!doctype html>
<html lang="zh-CN" data-theme={defaultTheme.value} data-scheme={defaultTheme.scheme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content={defaultTheme.themeColor} />
    <link rel="icon" type="image/png" sizes="48x48" href={favicon.src} />
    <link rel="apple-touch-icon" sizes="180x180" href={touchIcon.src} />
    <title>{title}</title>
    <script is:inline define:vars={{ themeOptions: themes, defaultThemeId: DEFAULT_THEME_ID, themeStorageKey: THEME_STORAGE_KEY }}>
      let theme = themeOptions.find((theme) => theme.value === defaultThemeId);
      try {
        const saved = localStorage.getItem(themeStorageKey);
        theme = themeOptions.find((theme) => theme.value === saved) ?? theme;
      } catch {}
      document.documentElement.dataset.theme = theme.value;
      document.documentElement.dataset.scheme = theme.scheme;
      document.querySelector('meta[name="theme-color"]')?.setAttribute('content', theme.themeColor);
    </script>
  </head>
  <body>
    <div class="flow-ribbon" aria-hidden="true"></div>
    <header class="site-header shell">
      <a class="wordmark" href="/" aria-label="Boy Jiang 首页">
        <span class="brand-mark" aria-hidden="true">
          <Image class="brand-logo brand-logo-light" src={logoLight} alt="" width={148} height={148} format="webp" loading="eager" />
          <Image class="brand-logo brand-logo-dark" src={logoDark} alt="" width={148} height={148} format="webp" loading="eager" />
        </span>
        <span class="wordmark-text">Boy Jiang</span>
      </a>
      <nav class="header-nav" aria-label="主导航">
        <span class="primary-nav-links">
          {primaryNav.map((item) => (
            <a class:list={[pathname.startsWith(item.href) && 'active']} href={item.href}>{item.label}</a>
          ))}
        </span>
        <span class="header-divider" aria-hidden="true"></span>
        <a class:list={['search-link', pathname.startsWith('/search/') && 'active']} href="/search/" aria-label="搜索">
          <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5"></circle><path d="m16 16 4 4"></path></svg>
        </a>
        <details class="theme-picker">
          <summary aria-label="选择主题" title="选择主题">
            <span class="theme-toggle-track" aria-hidden="true">
              <svg class="theme-moon" viewBox="0 0 24 24"><path d="M18.5 15.4A7.4 7.4 0 0 1 8.6 5.5 7.8 7.8 0 1 0 18.5 15.4Z"></path></svg>
              <span class="theme-toggle-knob">
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3.3"></circle><path d="M12 2.2v2.2M12 19.6v2.2M2.2 12h2.2M19.6 12h2.2M5.1 5.1l1.6 1.6M17.3 17.3l1.6 1.6M18.9 5.1l-1.6 1.6M6.7 17.3l-1.6 1.6"></path></svg>
              </span>
            </span>
          </summary>
          <div class="theme-panel">
            {themes.map((theme) => (
              <button type="button" data-theme-value={theme.value}>
                <span class={`theme-swatch ${theme.value}`} aria-hidden="true"></span>
                <strong>{theme.label}</strong>
                <span class="theme-check" aria-hidden="true">✓</span>
              </button>
            ))}
          </div>
        </details>
        <a class:list={['about-link', pathname === '/' && 'active']} href="/#about">关于</a>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer shell">
      <span>© 2026 Boy Jiang</span>
      <a href="https://github.com/BoyJiang2" rel="noreferrer">GitHub ↗</a>
    </footer>
    <script src="../scripts/theme-picker.ts"></script>
    <script src="../scripts/mermaid.ts"></script>
  </body>
</html>
