---
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'article'> {
  href: string;
  eyebrow?: string;
  meta?: string;
  title: string;
  summary: string;
  tags?: string[];
}

const { href, eyebrow, meta, title, summary, tags = [], class: className, ...attributes } = Astro.props;
const hasMeta = Boolean(eyebrow || meta);
---

<article {...attributes} class:list={['entry-row', !hasMeta && 'compact', className]}>
  {hasMeta && <div class="entry-meta">
    {eyebrow && <span>{eyebrow}</span>}
    {meta && <small>{meta}</small>}
  </div>}
  <div class="entry-body">
    <h3><a href={href}>{title}</a></h3>
    <p>{summary}</p>
    {tags.length > 0 && <div class="tag-line">{tags.map((tag) => <span>#{tag}</span>)}</div>}
  </div>
  <a class="entry-arrow" href={href} aria-label={`阅读 ${title}`}>↗</a>
</article>
