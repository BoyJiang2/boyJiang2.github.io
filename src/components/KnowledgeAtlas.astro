---
import { createHash } from 'node:crypto';
import atlasHTML from '../../public/knowledge-atlas/document.html?raw';

// Keep the reviewed local document intact; site styles must not restyle the atlas.
const version = createHash('sha256').update(atlasHTML).digest('hex').slice(0, 12);
const atlasURL = `/knowledge-atlas/document.html?v=${version}`;
---

<iframe
  class="knowledge-atlas-frame"
  data-atlas-frame
  src={atlasURL}
  title="体系结构与系统知识图谱"
  width="100%"
  height="1100"
  loading="eager"
></iframe>

<script>
  function initializeAtlasFrames() {
    document.querySelectorAll<HTMLIFrameElement>('[data-atlas-frame]').forEach((frame) => {
      if (frame.dataset.initialized) return;
      frame.dataset.initialized = 'true';
      let sizeObserver: ResizeObserver | undefined;
      const syncTheme = () => {
        const scheme = document.documentElement.dataset.scheme;
        if (frame.contentDocument && (scheme === 'dark' || scheme === 'light')) {
          frame.contentDocument.documentElement.dataset.theme = scheme;
        }
      };
      const connect = () => {
        const doc = frame.contentDocument;
        if (!doc?.body || !doc.querySelector('.wrap')) return;
        sizeObserver?.disconnect();
        syncTheme();
        const resize = () => {
          // Body content height, not viewport/scrollHeight: the frame must also shrink.
          const style = getComputedStyle(doc.body);
          const height = Math.ceil(doc.body.getBoundingClientRect().height
            + (parseFloat(style.marginTop) || 0) + (parseFloat(style.marginBottom) || 0));
          if (height > 0 && Math.abs(frame.getBoundingClientRect().height - height) > 1) {
            frame.style.height = `${height}px`;
          }
        };
        sizeObserver = new ResizeObserver(resize);
        sizeObserver.observe(doc.body);
        doc.fonts.ready.then(resize);
        resize();
      };
      frame.addEventListener('load', connect);
      new MutationObserver(syncTheme).observe(document.documentElement, {
        attributes: true, attributeFilter: ['data-scheme'],
      });
      connect();
    });
  }
  initializeAtlasFrames();
  document.addEventListener('astro:page-load', initializeAtlasFrames);
</script>

<style>
  .knowledge-atlas-frame {
    display: block;
    width: 100%;
    border: 0;
  }
</style>
