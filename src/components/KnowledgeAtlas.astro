---
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '../styles/atlas.css';
import { areas, DEFAULT_AREA } from '../data/atlas';
import AtlasIntro from './atlas/AtlasIntro.astro';
import AtlasSearch from './atlas/AtlasSearch.astro';
import AtlasDie from './atlas/AtlasDie.astro';
import AtlasDetail from './atlas/AtlasDetail.astro';
import AtlasCatalog from './atlas/AtlasCatalog.astro';
---

<div class="knowledge-atlas" data-knowledge-atlas>
  <a class="skip-link" href="#atlas-detail">跳到方向详情</a>
  <AtlasIntro />
  <AtlasSearch />
  <p id="atlas-status" class="sr-only" role="status" aria-live="polite" aria-atomic="true"></p>
  <AtlasDie />
  <noscript><p>切换方向、标签页和搜索需要启用 JavaScript；下面显示的是默认方向的概览。</p></noscript>
  <section class="detail" id="atlas-detail" aria-labelledby={`atlas-${DEFAULT_AREA}-heading`} tabindex="-1">
    {areas.map(area => <AtlasDetail area={area} />)}
  </section>
  <AtlasCatalog />
</div>

<script>
  import '../scripts/atlas';
</script>
