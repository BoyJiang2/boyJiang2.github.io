{
  "name": "notes-atlas",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": ["tools/llm-inference-calculator"],
  "engines": { "node": "^22.19.0 || ^24.0.0 || >=26.0.0" },
  "scripts": {
    "dev": "astro dev",
    "build": "npm test && astro build --force && npm run ui:build --workspace tools/llm-inference-calculator && npm run test:tools",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test tests/remark-display-math.test.mjs && npm test --workspace tools/llm-inference-calculator",
    "test:tools": "node --test tests/tools-build.test.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.11",
    "@astrojs/mdx": "^4.0.7",
    "@types/node": "^26.4.0",
    "astro": "^5.13.0",
    "katex": "0.18.4",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "typescript": "^5.7.2",
    "unified": "^11.0.5"
  },
  "overrides": {
    "katex": "$katex"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "mermaid": "^11.17.2"
  }
}
